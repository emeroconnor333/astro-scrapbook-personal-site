---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  href: string;
  painting: ImageMetadata;
}

const { title, href, painting } = Astro.props;
---
<a href={href} class="block h-full">
  <div class="relative h-full w-full overflow-hidden flex items-center justify-center bg-amber-100">
    <Image
      src={painting}
      alt=""
      format="webp"
      widths={[800, 1200]}
      sizes="(max-width: 800px) 100vw, (max-width: 1210px) 50vw, 33vw"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 border-[6px] border-white z-10 pointer-events-none" />
    <div class="relative z-10 w-full px-6 text-center">
      <span class="font-playfair text-3xl font-semibold text-white leading-tight [text-shadow:_0_2px_6px_rgba(0,0,0,0.5),_0_4px_12px_rgba(0,0,0,0.35)]">
        {title}
      </span>
    </div>
  </div>
</a>
