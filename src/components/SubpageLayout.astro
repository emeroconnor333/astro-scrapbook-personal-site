---
interface Props {
  stripes: { color: string; size: number }[];
}

const { stripes } = Astro.props;

let cursor = 0;
const stops = stripes.flatMap(({ color, size }) => {
  const start = cursor;
  cursor += size;
  return [`${color} ${start}px`, `${color} ${cursor}px`];
});
const gradient = `repeating-linear-gradient(180deg, ${stops.join(", ")})`;
---
<div
  id="drag-scroll-container"
  class="flex-1 overflow-x-auto overflow-y-hidden flex items-center"
  style="cursor: grab;"
>
  <div
    class="fixed inset-x-0 pointer-events-none z-0"
    style={`top: 16%; bottom: 13%; background-image: ${gradient};`}
  />
  <div
    class="relative z-10 flex flex-row items-stretch h-full px-4"
  >
    <slot />
  </div>
</div>

<script>
  const el = document.getElementById("drag-scroll-container");
  if (el) {
    let isDragging = false;
    let startX = 0;
    let scrollLeft = 0;

    el.addEventListener("mousedown", (e) => {
      e.preventDefault();
      isDragging = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
      el.style.cursor = "grabbing";
      el.style.userSelect = "none";
    });

    const endDrag = () => {
      isDragging = false;
      el.style.cursor = "grab";
      el.style.userSelect = "";
    };

    el.addEventListener("mouseup", endDrag);
    el.addEventListener("mouseleave", endDrag);

    el.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      el.scrollLeft = scrollLeft - (x - startX);
    });
  }
</script>
