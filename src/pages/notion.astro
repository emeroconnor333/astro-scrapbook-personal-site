---
import Layout from "../layouts/Layout.astro";
import SubpageLayout from "../components/SubpageLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import PinnedPhoto from "../components/PinnedPhoto.astro";
import Column from "../components/Column.astro";

import templateMetrics from "../assets/notion/template-metrics.png";
import templateReviews from "../assets/notion/template-reviews.png";
import mealPlanner from "../assets/notion/meal-planner-template.png";
import goalPlanner from "../assets/notion/goal-planner-template.png";
import readingTracker from "../assets/notion/reading-tracker-template.png";
---

<Layout title="Notion Templates | Emer O'Connor">
  <SubpageLayout stripes={[{color:"#f5d5d8",size:18},{color:"#e8b8b8",size:8},{color:"#f8f8f5",size:8},{color:"#d4e0c0",size:8},{color:"#f5d5d8",size:18},{color:"#e8b8b8",size:8},{color:"#f8f8f5",size:8}]}>

    <Column width="420px">
      <NoteCard>
        <p>
          Notion is one of my favourite pieces of software — I&apos;ve had basically my entire life organised in it since I created an account at 15. I love how intentional the design is and how you can build really specific templates from such simple components.
        </p>
        <p class="mt-3">
          A friend asked me to share a template I made for grocery shopping and meal planning in college, so I put it on the Notion marketplace and it ended up getting 30K+ downloads. I&apos;ve made some more templates since.
        </p>
      </NoteCard>
      <PinnedPhoto src={templateMetrics} alt="Template metrics" rotate="rotate-0" priority />
    </Column>

    <Column width="520px">
      <PinnedPhoto src={templateReviews} alt="Template reviews" rotate="rotate-0" priority />
      <PinnedPhoto src={mealPlanner} alt="The Ultimate Meal Planner" rotate="rotate-0" priority />
    </Column>

    <Column width="520px">
      <PinnedPhoto src={goalPlanner} alt="Goal Planner" rotate="rotate-0" />
      <PinnedPhoto src={readingTracker} alt="Reading Tracker" rotate="rotate-0" />
    </Column>

  </SubpageLayout>
</Layout>
